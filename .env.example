# Copy to .env and fill in only what you actually need — every value below has a
# safe mock-mode default, so the app runs with zero keys. See README.md#provider-architecture.

RESEARCHFORGE_ENVIRONMENT=development

# --- Search provider: mock | linkup | brightdata -----------------------------
RESEARCHFORGE_SEARCH_PROVIDER=mock
RESEARCHFORGE_LINKUP_API_KEY=
RESEARCHFORGE_BRIGHTDATA_API_KEY=
RESEARCHFORGE_BRIGHTDATA_ZONE=

# --- LLM provider: mock | anthropic | openai | gemini | ollama ---------------
RESEARCHFORGE_LLM_PROVIDER=mock
RESEARCHFORGE_ANTHROPIC_API_KEY=
RESEARCHFORGE_OPENAI_API_KEY=
RESEARCHFORGE_GEMINI_API_KEY=
RESEARCHFORGE_OLLAMA_BASE_URL=http://localhost:11434

# --- Per-task model routing (interpreted by whichever llm_provider is active) -
RESEARCHFORGE_PLANNER_MODEL=mock-reasoning
RESEARCHFORGE_EXTRACTION_MODEL=mock-fast
RESEARCHFORGE_FACT_CHECK_MODEL=mock-reasoning
RESEARCHFORGE_SYNTHESIS_MODEL=mock-quality
# Example if using Anthropic for everything:
# RESEARCHFORGE_PLANNER_MODEL=claude-sonnet-4-6
# RESEARCHFORGE_EXTRACTION_MODEL=claude-haiku-4-5
# RESEARCHFORGE_FACT_CHECK_MODEL=claude-sonnet-4-6
# RESEARCHFORGE_SYNTHESIS_MODEL=claude-sonnet-4-6

# --- Persistence ---------------------------------------------------------------
RESEARCHFORGE_DATABASE_URL=sqlite+aiosqlite:///./researchforge.db

# --- Orchestration limits --------------------------------------------------------
RESEARCHFORGE_MAX_CONCURRENT_RESEARCH_JOBS=5
RESEARCHFORGE_DEFAULT_TASK_TIMEOUT_SECONDS=60
RESEARCHFORGE_PROVIDER_MAX_RETRIES=3
RESEARCHFORGE_PROVIDER_RETRY_BACKOFF_SECONDS=1.5

# --- API -------------------------------------------------------------------------
RESEARCHFORGE_API_HOST=0.0.0.0
RESEARCHFORGE_API_PORT=8000
RESEARCHFORGE_MAX_REQUEST_BODY_BYTES=1000000
RESEARCHFORGE_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Observability -----------------------------------------------------------------
RESEARCHFORGE_LOG_LEVEL=INFO
RESEARCHFORGE_LOG_JSON=true

# --- Frontend (read by frontend/, not the backend) ---------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
